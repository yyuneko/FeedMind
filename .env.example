# Android/iOS API 根地址；本地 Web 开发服务器也会将 /api 代理到此地址。填写 /api，不要再追加 /v1。
EXPO_PUBLIC_FEEDMIND_API_URL=https://app.feedmind.cc/api
# 连接已部署 Cloudflare 与 Managed OAuth 时使用 production。
EXPO_PUBLIC_APP_ENV=production

# 可选：单独覆盖本地 Web 代理目标；默认使用 EXPO_PUBLIC_FEEDMIND_API_URL。
# FEEDMIND_DEV_API_PROXY_TARGET=https://app.feedmind.cc/api
# 可选：本地 Admin Web 的远程 API 代理目标。
# FEEDMIND_DEV_ADMIN_API_PROXY_TARGET=https://admin.feedmind.cc/api

# Worker Secrets（通过 wrangler secret put 配置，不要提交真实值）。
# SOURCE_CREDENTIALS_KEY=base64-encoded-32-byte-key
# READER_CREDENTIALS_KEY=independent-high-entropy-secret
