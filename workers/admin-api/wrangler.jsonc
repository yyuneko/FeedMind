{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "feedmind-admin-api",
  "account_id": "841c2769e1a55cd93c7e23470de8bff7",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-14",
  "workers_dev": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "steep-credit-754a.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "0fb1d330b27a750c38b95f813b38976cfcd497c37589612efdd0083bc9c73da9",
    "ALLOWED_ORIGIN": "https://admin.feedmind.cc",
    "MIGRATION_MODE": "normal"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "feedmind", "database_id": "a9c617e3-9f62-4eb3-99b0-1b5542ab0ca7", "migrations_dir": "../migrations" }
  ],
  "r2_buckets": [{ "binding": "CONTENT", "bucket_name": "feedmind-content" }],
  "queues": {
    "producers": [
      { "binding": "FEED_QUEUE", "queue": "feedmind-feed" },
      { "binding": "ARTICLE_QUEUE", "queue": "feedmind-article" }
    ]
  },
  "services": [
    { "binding": "AI_SERVICE", "service": "feedmind-ai-service" }
  ],
  "workflows": [
    {
      "name": "feedmind-classification",
      "binding": "CLASSIFICATION_WORKFLOW",
      "class_name": "ClassificationWorkflow",
      "script_name": "feedmind-translation-workflow"
    },
    {
      "name": "feedmind-body-translation",
      "binding": "BODY_TRANSLATION_WORKFLOW",
      "class_name": "TranslationWorkflow",
      "script_name": "feedmind-translation-workflow"
    }
  ]
}
