{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "feedmind-gpt-actions-api",
  "account_id": "841c2769e1a55cd93c7e23470de8bff7",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-14",
  "workers_dev": false,
  "routes": [{ "pattern": "actions.feedmind.cc", "custom_domain": true }],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "GPT_OAUTH_CLIENT_ID": "feedmind-chatgpt-action",
    "GPT_OAUTH_AUTHORIZE_URL": "https://app.feedmind.cc/oauth/authorize",
    "GPT_DAILY_REQUEST_LIMIT": "1000",
    "GPT_DAILY_WRITE_LIMIT": "50",
    "GPT_DAILY_TRANSLATION_LIMIT": "10",
    "GPT_TRANSLATION_CONCURRENCY": "2"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "feedmind", "database_id": "a9c617e3-9f62-4eb3-99b0-1b5542ab0ca7", "migrations_dir": "../migrations" }
  ],
  "r2_buckets": [{ "binding": "CONTENT", "bucket_name": "feedmind-content" }],
  "queues": {
    "producers": [
      { "binding": "FEED_QUEUE", "queue": "feedmind-feed" },
      { "binding": "ARTICLE_QUEUE", "queue": "feedmind-article" }
    ]
  },
  "ratelimits": [
    { "name": "GPT_RATE_LIMITER", "namespace_id": "754001", "simple": { "limit": 60, "period": 60 } }
  ],
  "workflows": [
    {
      "name": "feedmind-body-translation",
      "binding": "BODY_TRANSLATION_WORKFLOW",
      "class_name": "TranslationWorkflow",
      "script_name": "feedmind-translation-workflow"
    }
  ],
  "secrets": { "required": ["SOURCE_CREDENTIALS_KEY", "GPT_OAUTH_CLIENT_SECRET"] }
}
